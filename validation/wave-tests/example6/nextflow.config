docker {
  enabled = true
  envWhitelist = 'AWS_ACCESS_KEY_ID,AWS_SECRET_ACCESS_KEY,AWS_SESSION_TOKEN'
}

fusion {
  enabled = true
}

wave {
  build.template = 'conda/pixi:v1'
}

// Docker exit 125 is the daemon failing to start the container, including a
// registry pull reset. Retry that status and leave real task failures fatal.
process {
    errorStrategy = { task.exitStatus == 125 ? 'retry' : 'terminate' }
    maxRetries = 2
}

