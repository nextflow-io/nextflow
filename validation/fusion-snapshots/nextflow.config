params {
    steps = 600
    outdir = 'results'
    fis_template = env('E2E_FIS_TEMPLATE')
}

workDir = env('E2E_WORK_DIR')

process {
    executor = 'awsbatch'
    queue = env('E2E_SPOT_QUEUE')
}

aws {
    region = env('AWS_REGION')
    // must also carry job-role-policy.json
    batch.jobRole = env('E2E_JOB_ROLE')
}

wave {
    enabled = true
    strategy = ['conda']
}

fusion {
    enabled = true
    snapshots = true
}

trace {
    enabled = true
    file = 'trace.txt'
    overwrite = true
    fields = 'name,status,attempt'
}
