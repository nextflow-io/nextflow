set -e

#
# run normal mode
#
echo ''
$NXF_RUN | tee stdout

[[ `< .nextflow.log grep -c 'Submitted process > foo'` == 1 ]] || false
[[ `< .nextflow.log grep -c 'Re-submitted process > foo'` == 2 ]] || false

#
# RESUME mode
#
echo ''
$NXF_RUN -resume | tee stdout

[[ `< .nextflow.log grep -c 'Cached process > foo'` == 1 ]] || false

#
# RESUME mode after cleaning the run with the failed attempts, keeping the cached one (#7792)
#
echo ''
$NXF_CMD clean -f -but last | tee stdout

[[ `< stdout grep -c '^Removed'` == 2 ]] || false

$NXF_RUN -resume | tee stdout

[[ `< .nextflow.log grep -c 'Cached process > foo'` == 1 ]] || false
