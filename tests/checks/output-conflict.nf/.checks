set -e

#
# files from different values can be published to the same target
#
echo ''
$NXF_RUN | tee stdout

[[ `grep INFO .nextflow.log | grep -c 'Submitted process > MAKE'` == 3 ]] || false
[[ -f results/info/versions.yml ]] || false
[[ `wc -l < results/versions.csv` == 3 ]] || false
[[ -f results/reports/x.txt ]] || false
[[ -f results/reports/x.b.txt ]] || false

#
# files from the same value cannot be published to the same target
#
echo ''
rm -rf results
set +e
$NXF_RUN -resume --conflict > stdout 2>&1
status=$?
set -e
cat stdout

[ $status -ne 0 ] || false
grep -q 'is used by more than one file' stdout || false
[[ -z "$(ls results/reports 2>/dev/null)" ]] || false
