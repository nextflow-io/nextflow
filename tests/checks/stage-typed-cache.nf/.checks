set -e

#
# the stage block is edited in a copy of the script between runs
#
cp $NXF_SCRIPT main.nf
echo '>seq1' > input.fa
RUN="$NXF_CMD -q run main.nf --fasta $PWD/input.fa"

$RUN | tee .stdout
[[ `grep INFO .nextflow.log | grep -c 'Submitted process'` == 1 ]] || false
[[ `< .stdout grep 'query.fa'` ]] || false

$RUN -resume | tee .stdout
[[ `grep INFO .nextflow.log | grep -c 'Cached process'` == 1 ]] || false

# renaming a staged input does not invalidate the cache
sed -i.bak "s/'query.fa'/'renamed.fa'/" main.nf
$RUN -resume | tee .stdout
[[ `grep INFO .nextflow.log | grep -c 'Cached process'` == 1 ]] || false

# change the env expression
sed -i.bak 's/hello \${id}/goodbye \${id}/' main.nf
$RUN -resume | tee .stdout
[[ `grep INFO .nextflow.log | grep -c 'Submitted process'` == 1 ]] || false
[[ `< .stdout grep 'goodbye x'` ]] || false

# change the stdin expression
sed -i.bak 's/\${id}: one/\${id}: two/' main.nf
$RUN -resume | tee .stdout
[[ `grep INFO .nextflow.log | grep -c 'Submitted process'` == 1 ]] || false
[[ `< .stdout grep 'x: two'` ]] || false

$RUN -resume | tee .stdout
[[ `grep INFO .nextflow.log | grep -c 'Cached process'` == 1 ]] || false
[[ `< .stdout grep 'x: two'` ]] || false
