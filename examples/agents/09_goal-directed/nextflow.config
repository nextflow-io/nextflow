agent.runner = 'pi'

// `nf-agent-pi` ships no runtime: the agent proxy and the Node harness live in the
// runner image, so a `pi` agent always runs as a containerized task.

// the nf-core tools (skesa, assemblyscan, prokka) run in their containers,
// provisioned on-demand by Wave
wave.enabled = true
wave.strategy = 'conda,container'
docker.enabled = true
