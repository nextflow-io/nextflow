    },
    {
      "key": "EVAL_OUTPUTS",
      "contributor": "evalOutputs.derivedString"
    },
    {
      "key": "SCRIPT_VARS",
      "contributor": "scriptVars"
    },
    {
      "key": "BIN_ENTRIES",
      "contributor": "binEntries"
    },
    {
      "key": "ENV_MODULES",
      "contributor": "envModules"
    },
    {
      "key": "CONDA",
      "contributor": "condaEnv"
    },
    {
      "key": "SPACK",
      "contributor": "spackEnvAndArch"
    },
    {
      "key": "STUB_MARKER",
